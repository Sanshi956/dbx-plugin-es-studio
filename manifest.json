{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "local.es.studio",
  "name": "ES Studio",
  "version": "0.2.0",
  "publisher": "xihonglei",
  "description": "Professional Elasticsearch management workbench for DBX.",
  "icon": "assets/plugin.svg",
  "permissions": ["host.workbench", "host.storage", "host.connections:read", "host.events"],
  "engines": { "dbx": ">=0.5.68", "host_api": "1" },
  "entrypoints": {
    "backend": {
      "executable": "bin/es-studio-sidecar",
      "protocol_versions": [1],
      "transport": "stdio-jsonl"
    },
    "ui": { "root": "ui", "entry": "ui/index.html" }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "local.es.studio.connection",
      "label": "ES Studio (Elasticsearch)",
      "description": "ES Studio - Elasticsearch / Easysearch / OpenSearch cluster connection.",
      "icon": "assets/connection.svg",
      "database_type": "elasticsearch",
      "workbench": "local.es.studio.workbench",
      "capabilities": ["test", "connect", "disconnect"],
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "binding": "name",
          "required": true,
          "default": "ES Studio cluster"
        },
        {
          "key": "environment",
          "label": "Environment",
          "type": "select",
          "binding": "config",
          "default": "Development",
          "options": [
            { "label": "Development", "value": "Development" },
            { "label": "Test", "value": "Test" },
            { "label": "Staging", "value": "Staging" },
            { "label": "Production", "value": "Production" },
            { "label": "Custom", "value": "Custom" }
          ]
        },
        {
          "key": "protocol",
          "label": "Protocol",
          "type": "select",
          "binding": "config",
          "default": "http",
          "options": [
            { "label": "HTTP", "value": "http" },
            { "label": "HTTPS", "value": "https" }
          ]
        },
        {
          "key": "host",
          "label": "Host",
          "type": "text",
          "binding": "host",
          "required": true,
          "default": "localhost"
        },
        {
          "key": "port",
          "label": "Port",
          "type": "number",
          "binding": "port",
          "required": true,
          "default": 9200
        },
        {
          "key": "auth_type",
          "label": "Authentication",
          "type": "select",
          "binding": "config",
          "default": "none",
          "options": [
            { "label": "None", "value": "none" },
            { "label": "Basic Authentication", "value": "basic" },
            { "label": "API Key", "value": "api_key" },
            { "label": "Bearer Token", "value": "bearer" }
          ]
        },
        {
          "key": "username",
          "label": "Username",
          "type": "text",
          "binding": "username",
          "visible_when": { "field": "auth_type", "one_of": ["basic"] }
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "binding": "secret",
          "visible_when": { "field": "auth_type", "one_of": ["basic"] }
        },
        {
          "key": "api_key",
          "label": "API Key",
          "type": "password",
          "binding": "secret",
          "visible_when": { "field": "auth_type", "one_of": ["api_key"] }
        },
        {
          "key": "bearer_token",
          "label": "Bearer Token",
          "type": "password",
          "binding": "secret",
          "visible_when": { "field": "auth_type", "one_of": ["bearer"] }
        },
        {
          "key": "tls_verify",
          "label": "Verify TLS certificate",
          "type": "boolean",
          "binding": "config",
          "default": true
        },
        {
          "key": "timeout_secs",
          "label": "Request timeout (seconds)",
          "type": "number",
          "binding": "config",
          "default": 10
        },
        {
          "key": "description",
          "label": "Description",
          "type": "textarea",
          "binding": "config"
        },
        {
          "key": "read_only",
          "label": "Read only connection",
          "type": "boolean",
          "binding": "config",
          "default": false
        }
      ],
      "actions": [
        {
          "id": "test",
          "label": "Test Connection",
          "variant": "outline",
          "when": "always",
          "requires_valid_form": true,
          "timeout_ms": 15000
        }
      ]
    },
    {
      "type": "workbench",
      "id": "local.es.studio.workbench",
      "label": "ES Studio",
      "description": "Elasticsearch management workbench.",
      "icon": "assets/plugin.svg"
    },
    {
      "type": "context-menu",
      "id": "local.es.studio.open",
      "label": "Open ES Studio",
      "menu": "connection",
      "icon": "assets/plugin.svg",
      "action": { "type": "open-workbench", "workbench": "local.es.studio.workbench" }
    },
    {
      "type": "command",
      "id": "local.es.studio.open.command",
      "label": "Open ES Studio",
      "icon": "assets/plugin.svg",
      "action": {
        "type": "open-workbench",
        "workbench": "local.es.studio.workbench",
        "presentation": "tab"
      }
    },
    {
      "type": "menus",
      "id": "local.es.studio.menus",
      "items": [
        {
          "location": "appSidebar",
          "command": "local.es.studio.open.command",
          "group": "navigation",
          "order": 50,
          "default_visible": true
        },
        {
          "location": "commandPalette",
          "command": "local.es.studio.open.command",
          "group": "navigation",
          "order": 50
        }
      ]
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "ES Studio",
      "description": "DBX 内的 Elasticsearch 专业管理工作台。",
      "contributions": {
        "local.es.studio.connection": {
          "label": "ES Studio (Elasticsearch)",
          "description": "ES Studio —— Elasticsearch / Easysearch / OpenSearch 集群连接。",
          "fields": {
            "display_name": { "label": "连接名称" },
            "environment": { "label": "环境" },
            "protocol": { "label": "协议" },
            "host": { "label": "主机" },
            "port": { "label": "端口" },
            "auth_type": { "label": "认证方式" },
            "username": { "label": "用户名" },
            "password": { "label": "密码" },
            "api_key": { "label": "API Key" },
            "bearer_token": { "label": "Bearer Token" },
            "tls_verify": { "label": "校验证书" },
            "timeout_secs": { "label": "请求超时（秒）" },
            "description": { "label": "描述" },
            "read_only": { "label": "只读连接" }
          }
        },
        "local.es.studio.workbench": {
          "label": "ES Studio",
          "description": "Elasticsearch 管理工作台。"
        },
        "local.es.studio.open": { "label": "打开 ES Studio" },
        "local.es.studio.open.command": { "label": "打开 ES Studio" }
      }
    }
  }
}
